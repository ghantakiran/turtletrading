{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "buildCommand": "npm run build:vercel",
  "installCommand": "cd frontend && npm ci",
  "devCommand": "cd frontend && npm run dev",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}