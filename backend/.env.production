# Production Environment Configuration
ENVIRONMENT=production
DEBUG=false

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=TurtleTrading
VERSION=1.0.0

# CORS Settings
BACKEND_CORS_ORIGINS=["https://frontend-nextjs-jua5sqa4s-kirans-projects-994c7420.vercel.app", "https://*.vercel.app", "https://turtletrading.com"]

# Database (will be configured in Railway)
DATABASE_URL=postgresql://user:password@host:port/database

# Redis (will be configured in Railway)
REDIS_URL=redis://localhost:6379

# External APIs (will be set as environment variables)
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_API_KEY=

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json