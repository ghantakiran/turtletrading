{
  "name": "frontend-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lighthouse": "lhci autorun",
    "lighthouse:desktop": "lhci autorun --config ./lighthouse.config.js",
    "lighthouse:mobile": "lhci autorun --mobile",
    "performance:analyze": "ANALYZE=true npm run build",
    "performance:audit": "npm run build && npm run lighthouse",
    "performance:dev": "PERFORMANCE_MONITORING=true npm run dev",
    "perf:budgets": "node scripts/check-performance-budgets.js",
    "perf:report": "node scripts/generate-performance-report.js",
    "a11y:test": "jest --testPathPattern=accessibility",
    "a11y:audit": "npm run build && npm run a11y:lighthouse",
    "a11y:lighthouse": "lhci autorun --config ./lighthouse.config.js --collect.settings.onlyAudits=accessibility",
    "a11y:axe": "jest --testNamePattern='accessibility'",
    "a11y:keyboard": "jest --testNamePattern='keyboard navigation'",
    "a11y:contrast": "jest --testNamePattern='high contrast'",
    "a11y:report": "node scripts/generate-accessibility-report.js",
    "coverage:check": "jest --coverage --passWithNoTests --coverageThreshold='{\"global\":{\"branches\":100,\"functions\":100,\"lines\":100,\"statements\":100}}'",
    "coverage:enforce": "npm run coverage:check && npm run coverage:upload",
    "coverage:report": "jest --coverage --coverageReporters=html --coverageReporters=lcov --coverageReporters=text",
    "coverage:badge": "node scripts/generate-coverage-badge.js",
    "coverage:upload": "node scripts/upload-coverage-artifacts.js",
    "coverage:threshold": "node scripts/check-coverage-thresholds.js",
    "test:coverage:100": "npm run coverage:check"
  },
  "dependencies": {
    "@auth/core": "^0.34.2",
    "@auth/prisma-adapter": "^2.10.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.8",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-devtools": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.21",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "^0.14.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.10.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jest": "^30.1.3",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.1.2",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
