{
  "budgets": [
    {
      "name": "Performance Budget",
      "metrics": {
        "firstContentfulPaint": {
          "target": 1500,
          "warning": 2000,
          "error": 3000,
          "unit": "ms"
        },
        "largestContentfulPaint": {
          "target": 2500,
          "warning": 3000,
          "error": 4000,
          "unit": "ms"
        },
        "firstInputDelay": {
          "target": 100,
          "warning": 200,
          "error": 300,
          "unit": "ms"
        },
        "cumulativeLayoutShift": {
          "target": 0.1,
          "warning": 0.15,
          "error": 0.25,
          "unit": "score"
        },
        "timeToInteractive": {
          "target": 3000,
          "warning": 4000,
          "error": 5000,
          "unit": "ms"
        }
      },
      "resources": {
        "totalSize": {
          "target": 2000,
          "warning": 3000,
          "error": 4000,
          "unit": "KB"
        },
        "jsSize": {
          "target": 1000,
          "warning": 1500,
          "error": 2000,
          "unit": "KB"
        },
        "cssSize": {
          "target": 200,
          "warning": 300,
          "error": 500,
          "unit": "KB"
        },
        "imageSize": {
          "target": 500,
          "warning": 1000,
          "error": 1500,
          "unit": "KB"
        }
      }
    }
  ],
  "accessibility": {
    "wcagLevel": "AA",
    "rules": {
      "colorContrast": {
        "target": 4.5,
        "largText": 3.0
      },
      "keyboardNavigation": true,
      "focusManagement": true,
      "altText": true,
      "semanticHTML": true,
      "ariaLabels": true
    },
    "testing": {
      "automated": true,
      "manual": true,
      "tools": ["axe-core", "lighthouse", "wave"]
    }
  },
  "thresholds": {
    "lighthouse": {
      "performance": 90,
      "accessibility": 95,
      "bestPractices": 90,
      "seo": 85
    }
  }
}